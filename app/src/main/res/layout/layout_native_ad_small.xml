<?xml version="1.0" encoding="utf-8"?>
<!--
  Small native ad layout — fits within 320×200 dp.
  Total height: ~16+40+8+16+8+32+8 ≈ 128dp (well under 200dp).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: icon + headline + "Ad" label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- App icon (optional) -->
            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#757575"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- "Ad" badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ad"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#FF6B00"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

        <!-- Media view (image or video) — max 120dp tall -->
        <!-- Min 120x120dp required by AdMob for video. Width is match_parent (~360dp). -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp" />

        <!-- Call to action button -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
