<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <!-- Media thumbnail (photos, videos, carousels) -->
    <FrameLayout
        android:id="@+id/mediaFrame"
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Video indicator: play button, centered on tile -->
        <FrameLayout
            android:id="@+id/ivPlayOverlay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_rounded"
            android:visibility="gone">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_indicator"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Carousel count badge: rounded white square with number, top-right -->
        <FrameLayout
            android:id="@+id/carouselBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_rounded"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCarouselCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#99000000"
                android:textSize="13sp"
                android:textStyle="bold" />

        </FrameLayout>

    </FrameLayout>

    <!-- Text-only post preview (shown instead of thumbnail, same fixed height) -->
    <TextView
        android:id="@+id/tvTextPreview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:padding="12dp"
        android:textColor="#111111"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="6"
        android:ellipsize="end"
        android:gravity="top|start"
        android:visibility="gone" />

</com.google.android.material.card.MaterialCardView>
